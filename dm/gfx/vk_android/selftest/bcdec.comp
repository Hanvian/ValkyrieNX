void decode_bc6h(uvec4 blk, uint dst_base, bool is_signed) {
    uint b0 = blk.x & 0xffu;
    uint mnum, bit;
    if ((b0 & 2u) != 0u) { mnum = (((b0 >> 1u) & 0xeu) | (b0 & 1u)) + 2u; bit = 5u; }
    else { mnum = b0 & 3u; bit = 2u; }

    uint bf_off = 0u, bf_len = 0u, tr = 0u, pb = 0u, epb = 0u, ib = 0u, db0 = 0u, db1 = 0u, db2 = 0u;
    bool res = false;
    if (mnum == 0u)       { bf_off = 0u;   bf_len = 19u; tr = 1u; pb = 5u; epb = 10u; ib = 3u; db0 = 5u; db1 = 5u; db2 = 5u; }
    else if (mnum == 1u)  { bf_off = 19u;  bf_len = 23u; tr = 1u; pb = 5u; epb = 7u;  ib = 3u; db0 = 6u; db1 = 6u; db2 = 6u; }
    else if (mnum == 2u)  { bf_off = 42u;  bf_len = 18u; tr = 1u; pb = 5u; epb = 11u; ib = 3u; db0 = 5u; db1 = 4u; db2 = 4u; }
    else if (mnum == 3u)  { bf_off = 60u;  bf_len = 6u;  tr = 0u; pb = 0u; epb = 10u; ib = 4u; db0 = 10u; db1 = 10u; db2 = 10u; }
    else if (mnum == 4u)  { bf_off = 66u;  bf_len = 20u; tr = 1u; pb = 5u; epb = 11u; ib = 3u; db0 = 4u; db1 = 5u; db2 = 4u; }
    else if (mnum == 5u)  { bf_off = 86u;  bf_len = 9u;  tr = 1u; pb = 0u; epb = 11u; ib = 4u; db0 = 9u; db1 = 9u; db2 = 9u; }
    else if (mnum == 6u)  { bf_off = 95u;  bf_len = 20u; tr = 1u; pb = 5u; epb = 11u; ib = 3u; db0 = 4u; db1 = 4u; db2 = 5u; }
    else if (mnum == 7u)  { bf_off = 115u; bf_len = 9u;  tr = 1u; pb = 0u; epb = 12u; ib = 4u; db0 = 8u; db1 = 8u; db2 = 8u; }
    else if (mnum == 8u)  { bf_off = 124u; bf_len = 19u; tr = 1u; pb = 5u; epb = 9u;  ib = 3u; db0 = 5u; db1 = 5u; db2 = 5u; }
    else if (mnum == 9u)  { bf_off = 143u; bf_len = 9u;  tr = 1u; pb = 0u; epb = 16u; ib = 4u; db0 = 4u; db1 = 4u; db2 = 4u; }
    else if (mnum == 10u) { bf_off = 152u; bf_len = 19u; tr = 1u; pb = 5u; epb = 8u;  ib = 3u; db0 = 6u; db1 = 5u; db2 = 5u; }
    else if (mnum == 12u) { bf_off = 171u; bf_len = 21u; tr = 1u; pb = 5u; epb = 8u;  ib = 3u; db0 = 5u; db1 = 6u; db2 = 5u; }
    else if (mnum == 14u) { bf_off = 192u; bf_len = 21u; tr = 1u; pb = 5u; epb = 8u;  ib = 3u; db0 = 5u; db1 = 5u; db2 = 6u; }
    else if (mnum == 16u) { bf_off = 213u; bf_len = 23u; tr = 0u; pb = 5u; epb = 6u;  ib = 3u; db0 = 6u; db1 = 6u; db2 = 6u; }
    else res = true;

    if (res) {
        for (uint y = 0u; y < 4u; y++) {
            uint row = dst_base + y * pc.dst_row_words;
            for (uint x = 0u; x < 4u; x++) {
                dst[row + x * 2u] = 0u;
                dst[row + x * 2u + 1u] = 0x3c00u << 16u;
            }
        }
        return;
    }

    int ep[12];
    for (uint i = 0u; i < 12u; i++) ep[i] = 0;
    for (uint i = 0u; i < bf_len; i++) {
        uint desc = k_bfs[bf_off + i];
        uint idx = (desc & 3u) * 3u + ((desc >> 2u) & 3u);
        uint off = (desc >> 4u) & 15u;
        uint nbits = (desc >> 8u) & 15u;
        uint v = getbits(blk, bit, nbits);
        bit += nbits;
        if ((desc & 0x1000u) != 0u) v = bitfieldReverse(v) >> (32u - nbits);
        ep[idx] |= int(v << off);
    }

    uint n_ep = pb != 0u ? 4u : 2u;
    uint db[3] = uint[3](db0, db1, db2);
    if (tr != 0u) {
        int mask = (1 << int(epb)) - 1;
        for (uint e = 1u; e < n_ep; e++) {
            for (uint c = 0u; c < 3u; c++) {
                int d = sext(ep[e * 3u + c], db[c]);
                ep[e * 3u + c] = (ep[c] + d) & mask;
            }
        }
    }
    for (uint e = 0u; e < n_ep; e++) {
        for (uint c = 0u; c < 3u; c++) {
            int v = is_signed ? sext(ep[e * 3u + c], epb) : ep[e * 3u + c];
            ep[e * 3u + c] = bc6_unq(v, epb, is_signed);
        }
    }

    uint part = 0u, nsub = 1u, subsets = 0u;
    if (pb != 0u) {
        part = getbits(blk, bit, pb) & 31u;
        bit += pb;
        subsets = k_part2[part];
        nsub = 2u;
    }

    for (uint y = 0u; y < 4u; y++) {
        uint row = dst_base + y * pc.dst_row_words;
        for (uint x = 0u; x < 4u; x++) {
            uint texel = y * 4u + x;
            uint anc = texel > 0u ? 1u : 0u;
            if (nsub == 2u && texel > k_anc0[part]) anc++;
            uint is_anc = (texel == 0u || (nsub == 2u && k_anc0[part] == texel)) ? 1u : 0u;
            uint sub = (subsets >> (texel * 2u)) & 3u;
            uint idx = getbits(blk, bit + ib * texel - anc, ib - is_anc);
            uint e0_idx = (sub * 2u) * 3u, e1_idx = (sub * 2u + 1u) * 3u;
            uint h[3];
            for (uint c = 0u; c < 3u; c++) {
                int v = bptc_interp(ep[e0_idx + c], ep[e1_idx + c], idx, ib);
                if (is_signed) h[c] = uint(v < 0 ? (((-v * 31) / 32) | 0x8000) : ((v * 31) / 32)) & 0xffffu;
                else h[c] = uint((v * 31) / 64) & 0xffffu;
            }
            dst[row + x * 2u] = h[0] | (h[1] << 16u);
            dst[row + x * 2u + 1u] = h[2] | (0x3c00u << 16u);
        }
    }
}

void main() {
    uint gx = gl_GlobalInvocationID.x;
    uint gy = gl_GlobalInvocationID.y;
    uint gz = gl_GlobalInvocationID.z;
    if (gx >= pc.bx || gy >= pc.by || gz >= pc.layers) return;

    uint bwords = pc.kind <= 2u ? 2u : 4u;
    uint soff = gz * pc.src_layer_words + gy * pc.src_row_words + gx * bwords;
    uint wpw = pc.kind <= 2u ? 1u : (pc.kind <= 4u ? 2u : (pc.kind == 7u ? 4u : 8u));
    uint doff = gz * pc.dst_layer_words + (gy * 4u) * pc.dst_row_words + gx * wpw;

    if (pc.kind <= 2u) {
        uvec2 blk = uvec2(src[soff], src[soff + 1u]);
        for (uint y = 0u; y < 4u; y++) {
            uint b0 = pc.kind == 1u ? bc4_byte_u(blk, y * 4u + 0u) : bc4_byte_s(blk, y * 4u + 0u);
            uint b1 = pc.kind == 1u ? bc4_byte_u(blk, y * 4u + 1u) : bc4_byte_s(blk, y * 4u + 1u);
            uint b2 = pc.kind == 1u ? bc4_byte_u(blk, y * 4u + 2u) : bc4_byte_s(blk, y * 4u + 2u);
            uint b3 = pc.kind == 1u ? bc4_byte_u(blk, y * 4u + 3u) : bc4_byte_s(blk, y * 4u + 3u);
            dst[doff + y * pc.dst_row_words] = b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
        }
    } else if (pc.kind <= 4u) {
        uvec2 b_r = uvec2(src[soff], src[soff + 1u]);
        uvec2 b_g = uvec2(src[soff + 2u], src[soff + 3u]);
        for (uint y = 0u; y < 4u; y++) {
            uint row = doff + y * pc.dst_row_words;
            uint r0 = pc.kind == 3u ? bc4_byte_u(b_r, y * 4u + 0u) : bc4_byte_s(b_r, y * 4u + 0u);
            uint g0 = pc.kind == 3u ? bc4_byte_u(b_g, y * 4u + 0u) : bc4_byte_s(b_g, y * 4u + 0u);
            uint r1 = pc.kind == 3u ? bc4_byte_u(b_r, y * 4u + 1u) : bc4_byte_s(b_r, y * 4u + 1u);
            uint g1 = pc.kind == 3u ? bc4_byte_u(b_g, y * 4u + 1u) : bc4_byte_s(b_g, y * 4u + 1u);
            uint r2 = pc.kind == 3u ? bc4_byte_u(b_r, y * 4u + 2u) : bc4_byte_s(b_r, y * 4u + 2u);
            uint g2 = pc.kind == 3u ? bc4_byte_u(b_g, y * 4u + 2u) : bc4_byte_s(b_g, y * 4u + 2u);
            uint r3 = pc.kind == 3u ? bc4_byte_u(b_r, y * 4u + 3u) : bc4_byte_s(b_r, y * 4u + 3u);
            uint g3 = pc.kind == 3u ? bc4_byte_u(b_g, y * 4u + 3u) : bc4_byte_s(b_g, y * 4u + 3u);
            dst[row]      = r0 | (g0 << 8u) | (r1 << 16u) | (g1 << 24u);
            dst[row + 1u] = r2 | (g2 << 8u) | (r3 << 16u) | (g3 << 24u);
        }
    } else if (pc.kind <= 6u) {
        uvec4 blk = uvec4(src[soff], src[soff + 1u], src[soff + 2u], src[soff + 3u]);
        decode_bc6h(blk, doff, pc.kind == 5u);
    } else if (pc.kind == 7u) {
        uvec4 blk = uvec4(src[soff], src[soff + 1u], src[soff + 2u], src[soff + 3u]);
        decode_bc7(blk, doff);
    }
}
