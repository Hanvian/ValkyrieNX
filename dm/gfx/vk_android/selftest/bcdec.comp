#version 450
// GPU software decoder for BC4 / BC5 / BC6H / BC7 blocks (fallback for drivers lacking hardware BC4-7, e.g. Samsung Xclipse SPAL).
// Decodes block-linear/strided compressed blocks in Src (binding 0) into unpacked 4-pixel-aligned scanlines in Dst (binding 1).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, std430, binding = 0) readonly buffer SrcBuf { uint src[]; };
layout(set = 0, std430, binding = 1) writeonly buffer DstBuf { uint dst[]; };

layout(push_constant) uniform PC {
    uint kind;            // 1 BC4_UNORM, 2 BC4_SNORM, 3 BC5_UNORM, 4 BC5_SNORM, 5 BC6H_SFLOAT, 6 BC6H_UFLOAT, 7 BC7
    uint bx;              // blocks across
    uint by;              // blocks high
    uint layers;          // array layers or depth slices
    uint src_row_words;   // stride in uints between block rows in src
    uint src_layer_words; // stride in uints between layers in src
    uint dst_row_words;   // stride in uints between pixel rows in dst (= bx * block_row_words)
    uint dst_layer_words; // stride in uints between layers in dst (= by * 4 * dst_row_words)
} pc;

