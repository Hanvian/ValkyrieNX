uint getbits(uvec4 b, uint pos, uint n) {
    if (n == 0u) return 0u;
    uint wi = pos >> 5u;
    uint sh = pos & 31u;
    uint w0 = wi == 0u ? b.x : (wi == 1u ? b.y : (wi == 2u ? b.z : b.w));
    uint lo = w0 >> sh;
    if (sh + n > 32u) {
        uint wi1 = wi + 1u;
        uint w1 = wi1 == 1u ? b.y : (wi1 == 2u ? b.z : (wi1 == 3u ? b.w : 0u));
        lo |= w1 << (32u - sh);
    }
    return lo & ((1u << n) - 1u);
}

int sext(int v, uint bits) {
    int m = 1 << int(bits - 1u);
    return (v ^ m) - m;
}

int bptc_interp(int a, int b, uint idx, uint bits) {
    uint w = 0u;
    if (bits == 2u) {
        w = idx == 0u ? 0u : (idx == 1u ? 21u : (idx == 2u ? 43u : 64u));
    } else if (bits == 3u) {
        const uint w3[8] = uint[8](0u, 9u, 18u, 27u, 37u, 46u, 55u, 64u);
        w = w3[idx];
    } else {
        const uint w4[16] = uint[16](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u, 34u, 38u, 43u, 47u, 51u, 55u, 60u, 64u);
        w = w4[idx];
    }
    return ((64 - int(w)) * a + int(w) * b + 32) >> 6;
}

uint bc4_byte_u(uvec2 blk, uint texel) {
    uint e0 = blk.x & 0xffu;
    uint e1 = (blk.x >> 8u) & 0xffu;
    uint bitpos = 16u + texel * 3u;
    uint c = ((bitpos < 32u)
        ? ((blk.x >> bitpos) | ((bitpos + 3u > 32u) ? (blk.y << (32u - bitpos)) : 0u))
        : (blk.y >> (bitpos - 32u))) & 7u;
    if (c == 0u) return e0;
    if (c == 1u) return e1;
    if (e0 > e1) {
        uint i = c - 2u;
        return ((6u - i) * e0 + (i + 1u) * e1 + 3u) / 7u;
    }
    if (c == 6u) return 0u;
    if (c == 7u) return 255u;
    uint i = c - 2u;
    return ((4u - i) * e0 + (i + 1u) * e1 + 2u) / 5u;
}

uint bc4_byte_s(uvec2 blk, uint texel) {
    int s0 = sext(int(blk.x & 0xffu), 8u);
    int s1 = sext(int((blk.x >> 8u) & 0xffu), 8u);
    int e0 = s0 == -128 ? -127 : s0;
    int e1 = s1 == -128 ? -127 : s1;
    uint bitpos = 16u + texel * 3u;
    uint c = ((bitpos < 32u)
        ? ((blk.x >> bitpos) | ((bitpos + 3u > 32u) ? (blk.y << (32u - bitpos)) : 0u))
        : (blk.y >> (bitpos - 32u))) & 7u;
    int outv;
    if (c == 0u) outv = e0;
    else if (c == 1u) outv = e1;
    else if (e0 > e1) {
        int i = int(c) - 2;
        int v = (6 - i) * e0 + (i + 1) * e1;
        outv = v >= 0 ? (v + 3) / 7 : (v - 3) / 7;
    } else if (c == 6u) outv = -127;
    else if (c == 7u) outv = 127;
    else {
        int i = int(c) - 2;
        int v = (4 - i) * e0 + (i + 1) * e1;
        outv = v >= 0 ? (v + 2) / 5 : (v - 2) / 5;
    }
    return uint(outv) & 0xffu;
}

uint bc7_expand(uint v, uint bits) {
    return bits == 8u ? v : (((v << (8u - bits)) | (v >> (2u * bits - 8u))) & 0xffu);
}

void decode_bc7(uvec4 blk, uint dst_base) {
    uint b0 = blk.x & 0xffu;
    if (b0 == 0u) {
        for (uint y = 0u; y < 4u; y++) {
            uint row = dst_base + y * pc.dst_row_words;
            dst[row] = 0u; dst[row + 1u] = 0u; dst[row + 2u] = 0u; dst[row + 3u] = 0u;
        }
        return;
    }
    uint m = 0u;
    while (((b0 >> m) & 1u) == 0u) m++;
    // {n_subsets, n_part_bits, has_rot, has_idx_sel, n_color_bits, n_alpha_bits, has_ep_pbits, has_sh_pbits, n_idx_bits, n_idx2_bits}
    const uint m_sub[8] = uint[8](3u, 2u, 3u, 2u, 1u, 1u, 1u, 2u);
    const uint m_part[8] = uint[8](4u, 6u, 6u, 6u, 0u, 0u, 0u, 6u);
    const uint m_rot[8] = uint[8](0u, 0u, 0u, 0u, 1u, 1u, 0u, 0u);
    const uint m_isel[8] = uint[8](0u, 0u, 0u, 0u, 1u, 0u, 0u, 0u);
    const uint m_cb[8] = uint[8](4u, 6u, 5u, 7u, 5u, 7u, 7u, 5u);
    const uint m_ab[8] = uint[8](0u, 0u, 0u, 0u, 6u, 8u, 7u, 5u);
    const uint m_epp[8] = uint[8](1u, 0u, 0u, 1u, 0u, 0u, 1u, 1u);
    const uint m_shp[8] = uint[8](0u, 1u, 0u, 0u, 0u, 0u, 0u, 0u);
    const uint m_i1[8] = uint[8](3u, 3u, 2u, 2u, 2u, 2u, 4u, 2u);
    const uint m_i2[8] = uint[8](0u, 0u, 0u, 0u, 3u, 2u, 0u, 0u);

    uint nsub = m_sub[m], npb = m_part[m], hrot = m_rot[m], hisel = m_isel[m];
    uint ncb = m_cb[m], nab = m_ab[m], hepp = m_epp[m], hshp = m_shp[m];
    uint ni1 = m_i1[m], ni2 = m_i2[m];
    uint bit = m + 1u;

    uint part = getbits(blk, bit, npb);
    bit += npb;
    uint subsets = nsub == 1u ? 0u : (nsub == 2u ? k_part2[part] : k_part3[part]);
    uint rot = hrot != 0u ? getbits(blk, bit, 2u) : 0u;
    bit += hrot * 2u;
    uint isel = hisel != 0u ? getbits(blk, bit, 1u) : 0u;
    bit += hisel;

    uint ep[24];
    for (uint c = 0u; c < 3u; c++) {
        for (uint s = 0u; s < nsub; s++) {
            for (uint e = 0u; e < 2u; e++) {
                ep[(s * 2u + e) * 4u + c] = getbits(blk, bit, ncb);
                bit += ncb;
            }
        }
    }
    uint ncomp = 3u;
    if (nab > 0u) {
        for (uint s = 0u; s < nsub; s++) {
            for (uint e = 0u; e < 2u; e++) {
                ep[(s * 2u + e) * 4u + 3u] = getbits(blk, bit, nab);
                bit += nab;
            }
        }
        ncomp = 4u;
    } else {
        for (uint s = 0u; s < nsub; s++) {
            for (uint e = 0u; e < 2u; e++) ep[(s * 2u + e) * 4u + 3u] = 255u;
        }
    }
    if (hepp != 0u) {
        for (uint s = 0u; s < nsub; s++) {
            for (uint e = 0u; e < 2u; e++) {
                uint pb = getbits(blk, bit, 1u); bit += 1u;
                uint idx = (s * 2u + e) * 4u;
                for (uint c = 0u; c < ncomp; c++) ep[idx + c] = (ep[idx + c] << 1u) | pb;
            }
        }
    } else if (hshp != 0u) {
        for (uint s = 0u; s < nsub; s++) {
            uint pb = getbits(blk, bit, 1u); bit += 1u;
            for (uint e = 0u; e < 2u; e++) {
                uint idx = (s * 2u + e) * 4u;
                for (uint c = 0u; c < ncomp; c++) ep[idx + c] = (ep[idx + c] << 1u) | pb;
            }
        }
    }
    uint cb = ncb + hepp + hshp;
    uint ab = nab + hepp + hshp;
    for (uint s = 0u; s < nsub; s++) {
        for (uint e = 0u; e < 2u; e++) {
            uint idx = (s * 2u + e) * 4u;
            for (uint c = 0u; c < 3u; c++) ep[idx + c] = bc7_expand(ep[idx + c], cb);
            if (nab > 0u) ep[idx + 3u] = bc7_expand(ep[idx + 3u], ab);
        }
    }

    for (uint y = 0u; y < 4u; y++) {
        uint row = dst_base + y * pc.dst_row_words;
        for (uint x = 0u; x < 4u; x++) {
            uint texel = y * 4u + x;
            uint anc = texel > 0u ? 1u : 0u;
            if (nsub == 2u && texel > k_anc0[part]) anc++;
            else if (nsub == 3u) {
                if (texel > k_anc1[part]) anc++;
                if (texel > k_anc2[part]) anc++;
            }
            uint is_anc = 0u;
            if (texel == 0u) is_anc = 1u;
            else if (nsub == 2u && k_anc0[part] == texel) is_anc = 1u;
            else if (nsub == 3u && (k_anc1[part] == texel || k_anc2[part] == texel)) is_anc = 1u;

            uint off1 = bit + ni1 * texel - anc;
            uint off2 = bit + 16u * ni1 - nsub + ni2 * texel - anc;
            uint sub = (subsets >> (texel * 2u)) & 3u;
            uint i0 = getbits(blk, off1, ni1 - is_anc);
            uint i1 = ni2 != 0u ? getbits(blk, off2, ni2 - is_anc) : 0u;

            uint ci = isel != 0u ? i1 : i0;
            uint cb_i = isel != 0u ? ni2 : ni1;
            uint e0_idx = (sub * 2u) * 4u, e1_idx = (sub * 2u + 1u) * 4u;
            uint px[4];
            for (uint c = 0u; c < 3u; c++)
                px[c] = uint(bptc_interp(int(ep[e0_idx + c]), int(ep[e1_idx + c]), ci, cb_i)) & 0xffu;

            uint ai = (ni2 != 0u && isel == 0u) ? i1 : i0;
            uint ab_i = (ni2 != 0u && isel == 0u) ? ni2 : ni1;
            px[3] = uint(bptc_interp(int(ep[e0_idx + 3u]), int(ep[e1_idx + 3u]), ai, ab_i)) & 0xffu;

            if (rot != 0u) {
                uint t = px[rot - 1u];
                px[rot - 1u] = px[3];
                px[3] = t;
            }
            dst[row + x] = px[0] | (px[1] << 8u) | (px[2] << 16u) | (px[3] << 24u);
        }
    }
}

int bc6_unq(int v, uint bits, bool is_signed) {
    if (is_signed) {
        if (bits >= 16u || v == 0) return v;
        bool neg = v < 0;
        if (neg) v = -v;
        v = (v >= (1 << int(bits - 1u)) - 1) ? 0x7fff : (((v << 15) + 0x4000) >> int(bits - 1u));
        return neg ? -v : v;
    }
    if (bits >= 15u || v == 0) return v;
    if (v == (1 << int(bits)) - 1) return 0xffff;
    return ((v << 15) + 0x4000) >> int(bits - 1u);
}

#define BF(e, c, off, n, r) ((uint(e)) | (uint(c) << 2u) | (uint(off) << 4u) | (uint(n) << 8u) | (uint(r) << 12u))

